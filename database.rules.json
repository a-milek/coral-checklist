{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "$room.length >= 8",
        ".write": "$room.length >= 8",
        "checks": {
          "$key": {
            ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').isString() && newData.child('by').val().length <= 20 && newData.child('at').isNumber()"
          }
        }
      }
    }
  }
}
